  "effective_rate_rule": {
    "formula": "(before_annual_total - after_annual_total) / (income_to - income_from) * 100",
    "denominator": "annual income increase in won",
    "existence": "the rate exists only when annual income strictly increases; flat or falling income yields null",
    "wrong_numerator_example": "Using a 2-year support total change as the numerator over the annual income gap is wrong"
  },
  "present_value_rule": {
    "formula": "A / (1 + r)^(m / 12)",
    "monthly": "discount each monthly payment at its own month m",
    "maturity": "discount the lump sum at the maturity month",
    "unknown_rate": "return null; never assert zero"
