{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benefitfinder.example/contracts/v1/common.schema.json",
  "$defs": {
    "domain_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "checked_at", "document_version"],
      "properties": {
        "url": {"type": "string", "format": "uri", "pattern": "^https?://"},
        "checked_at": {"type": "string", "format": "date-time"},
        "document_version": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quote", "source"],
      "properties": {
        "quote": {"type": "string", "minLength": 1},
        "location": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "amount_breakdown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cash_in_period_won",
        "expected_accrual_won"
      ],
      "properties": {
        "cash_in_period_won": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "선택 기간 내 실제 현금 지급 예정액. 현재가치 할인 전 명목금액이다."
        },
        "expected_accrual_won": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "선택 기간까지 적립되지만 만기 전이라 아직 지급되지 않는 검수된 예상 지원금. 본인 납입금 제외. 현재가치 합계에는 넣지 않는다."
        }
      },
      "description": "만기 지급이 포함된 경우의 명목 현금·미지급 예상 적립액 구분. PV off 합계는 두 값의 합, PV on 합계는 기간 내 현금의 현재가치다."
    }
  }
}
