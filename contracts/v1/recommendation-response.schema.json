{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benefitfinder.example/contracts/v1/recommendation-response.schema.json",
  "title": "Recommendation response",
  "description": "POST /api/v1/recommendations 최종 result. 13단계 선택지 단일 계약이며 결과 추가 질문 필드는 없다. 3기간(1y/2y/all)xPV on/off 6가지를 results에 한 번에 담는다. view는 전역 초기 기준(기본 선택 1y+PV 끔, 즉 results[1y][pv_off]의 결과와 일치)이다. 기간/PV 탭 전환 시 화면은 다시 묻지 않고 선택 탭의 result_view를 따라 표시 섹션을 바꾼다(portfolios가 있으면 카드, 없으면 그 탭의 fallback_list, 둘 다 없으면 비어 있음). 조건 판정의 met/not_met은 근거 1개 이상 필수, 미상은 needs_review. need_check 상태값은 거부된다. 모든 업무 불변식을 스키마 하나로 강제하지 않고 구조+문서/테스트로 검증한다.",
  "type": "object",
  "additionalProperties": false,
  "dependentRequired": {
    "services": ["services_total_won"],
    "services_total_won": ["services"]
  },
  "required": [
    "request_id",
    "domain",
    "view",
    "results",
    "ai_generated",
    "data_updated_at",
    "discount_rate",
    "discount_rate_status"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "$ref": "common.schema.json#/$defs/domain_id"
    },
    "virtual_data": {
      "type": "boolean",
      "description": "true면 가상 정책·금액의 개발용 계산이다. 화면과 저장 이미지에 실제 추천이 아님을 표시한다. 생략은 실제 자료 검증 완료를 뜻하지 않는다."
    },
    "services": {
      "type": "array",
      "items": {"$ref": "#/$defs/service_entry"},
      "description": "F14 비현금 서비스. 생략은 서비스 미지원, 빈 배열은 조회했지만 후보 없음. 기간·현재가치와 별도."
    },
    "services_total_won": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "근거 있는 서비스 환산액만 합한 서버 값. 환산 가능 항목이 없거나 안전 정수 범위를 넘으면 null."
    },
    "view": {
      "enum": [
        "portfolio",
        "fallback_list",
        "empty"
      ],
      "description": "전역 초기 기준. results[1y][pv_off]의 표시 섹션과 일치한다."
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "1y",
        "2y",
        "all"
      ],
      "properties": {
        "1y": {
          "$ref": "#/$defs/period_result"
        },
        "2y": {
          "$ref": "#/$defs/period_result"
        },
        "all": {
          "$ref": "#/$defs/period_result"
        }
      }
    },
    "ai_generated": {
      "type": "boolean",
      "description": "응답 중 AI 생성 설명이 하나라도 있으면 true, 모두 기본 근거 템플릿이면 false다. 각 정책의 ai_generated가 해당 항목 기준이다."
    },
    "data_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "discount_rate": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "현재가치 할인율(연). 기준금리 미확인이면 null. null일 때 0 할인율로 확정하지 않는다."
    },
    "discount_rate_status": {
      "enum": [
        "verified",
        "unknown"
      ]
    }
  },
  "$defs": {
    "service_entry": {
      "title": "Recommended service",
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "title", "categories", "application", "source", "service", "eligibility"],
      "properties": {
        "policy_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "categories": {"$ref": "benefit.schema.json#/properties/categories"},
        "application": {"$ref": "benefit.schema.json#/properties/application"},
        "source": {"$ref": "common.schema.json#/$defs/source"},
        "service": {"$ref": "service.schema.json"},
        "eligibility": {"type": "array", "items": {"$ref": "#/$defs/condition_result"}}
      }
    },
    "period_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pv_off",
        "pv_on"
      ],
      "properties": {
        "pv_off": {
          "$ref": "#/$defs/result_view"
        },
        "pv_on": {
          "$ref": "#/$defs/result_view"
        }
      }
    },
    "result_view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "portfolios",
        "calculation_status",
        "unavailable_reason"
      ],
      "properties": {
        "portfolios": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/portfolio"
          }
        },
        "why": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "gap_won": {
              "type": [
                "integer",
                "null"
              ]
            },
            "second_total_won": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "deciding_conflict": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/excluded_item"
          }
        },
        "not_eligible": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "policy_id",
              "failed"
            ],
            "properties": {
              "policy_id": {
                "type": "string",
                "minLength": 1
              },
              "failed": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "not_yet_reviewed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "policy_id",
              "eligibility_summary"
            ],
            "properties": {
              "policy_id": {
                "type": "string",
                "minLength": 1
              },
              "eligibility_summary": {
                "enum": [
                  "met",
                  "not_met",
                  "needs_review"
                ]
              },
              "policy_name": {
                "type": "string",
                "minLength": 1,
                "description": "F12 승인 preview용 실제 정책명. review_explanation이 있을 때 필수다."
              },
              "review_scope": {
                "type": "string",
                "minLength": 1,
                "description": "F12 승인 preview가 확인한 범위 메모(조합/자격/금액 확정 전). review_explanation이 있을 때 필수다."
              },
              "verification_only": {
                "const": true,
                "description": "F12 승인 preview 표시. true 고정이며 수급·신청 보장이 아니다. review_explanation이 있을 때 필수다."
              },
              "review_explanation": {
                "$ref": "#/$defs/portfolio_policy",
                "description": "F12 승인 preview 설명. portfolio_policy를 재사용하며 금액 미확정(null)·자격 미확정(needs_review 또는 빈 배열)으로만 둔다. 있을 때 policy_name/review_scope/verification_only가 필수이며 policy_id 동일성은 애플리케이션 검증으로 확인한다."
              }
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "review_explanation"
                  ]
                },
                "then": {
                  "required": [
                    "policy_name",
                    "review_scope",
                    "verification_only"
                  ],
                  "properties": {
                    "eligibility_summary": {
                      "const": "needs_review"
                    },
                    "review_explanation": {
                      "properties": {
                        "amount_in_period_won": {
                          "type": "null"
                        },
                        "original_amount_won": {
                          "type": "null"
                        },
                        "amount_status": {
                          "const": "unknown"
                        },
                        "eligibility": {
                          "items": {
                            "properties": {
                              "status": {
                                "const": "needs_review"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        "closed_now": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "policy_id"
            ],
            "properties": {
              "policy_id": {
                "type": "string",
                "minLength": 1
              },
              "last_period": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "next_expected": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "fallback_list": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/fallback_item"
          },
          "description": "선택 탭의 목록(6.3 예시 위치). 후보 1개 이하라 묶음을 못 만들 때 최대 5개. 탭과 무관하게 후보 수로 정해지므로 통상 6가지 탭에서 동일하다."
        },
        "calculation_status": {
          "enum": [
            "available",
            "unavailable"
          ],
          "description": "PV 금리 unknown 등 계산 불가 분기는 unavailable. unavailable이면 portfolios 빈 배열, 합계 추정 안 함(정상 raw 분기만 활성)."
        },
        "unavailable_reason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "missing_discount_rate",
            "unknown_payment_timing",
            null
          ],
          "description": "available이면 null. unavailable이면 사유 필수."
        }
      },
      "description": "선택 탭의 계산 결과. 6.3 예시 위치에 fallback_list를 둔다.",
      "allOf": [
        {
          "if": {
            "properties": {
              "calculation_status": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "properties": {
              "portfolios": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "calculation_status": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "properties": {
              "unavailable_reason": {
                "enum": [
                  "missing_discount_rate",
                  "unknown_payment_timing"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "calculation_status": {
                "const": "available"
              }
            }
          },
          "then": {
            "properties": {
              "unavailable_reason": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "portfolio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "total_won",
        "policies"
      ],
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "total_won": {
          "type": "integer",
          "minimum": 0,
          "description": "원 단위 정수. 조합은 검수 확정 금액만 포함하므로 항상 정수. 미상 시나리오는 unavailable 분기로 표현하고 여기서 null을 쓰지 않는다."
        },
        "present_value_applied": {
          "type": "boolean"
        },
        "policies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/portfolio_policy"
          }
        },
        "given_up": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "policy_id"
            ],
            "properties": {
              "policy_id": {
                "type": "string",
                "minLength": 1
              },
              "amount_won": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        },
        "unverified_pairs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "a",
              "b",
              "note"
            ],
            "properties": {
              "a": {
                "type": "string",
                "minLength": 1
              },
              "b": {
                "type": "string",
                "minLength": 1
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "portfolio_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "eligibility",
        "source"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "amount_in_period_won": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "original_amount_won": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "amount_status": {
          "enum": [
            "verified",
            "unknown"
          ]
        },
        "eligibility": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition_result"
          }
        },
        "ai_reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "6장 초안 필드명을 호환을 위해 유지한 추천 이유 텍스트. 템플릿을 포함하며 생성형 AI 작성 여부는 ai_generated 플래그와 함께 해석한다. 최종 필드명은 회의에서 정리한다. 민감 특수조건/부모정보를 쓰지 않는다."
        },
        "ai_generated": {
          "type": "boolean",
          "description": "이 정책 설명을 생성형 AI가 작성했으면 true, 기본 근거 템플릿이면 false다. 생략하면 이전 응답과 같이 취급하며 최상위 ai_generated로만 해석한다."
        },
        "ai_sources": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "allOf": [
              {
                "$ref": "common.schema.json#/$defs/evidence"
              },
              {
                "type": "object",
                "properties": {
                  "location": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "location"
                ]
              }
            ]
          },
          "description": "AI 생성 설명에 사용한 게시 조항 원문 인용 최대 5개. quote=게시 조항 전체 원문, location=조항 ID(필수), source=url/checked_at/document_version. evidence 정의를 재사용하되 location을 필수로 한다(다른 evidence의 location 선택성은 유지)."
        },
        "source": {
          "$ref": "common.schema.json#/$defs/source"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "ai_generated": {
                "const": true
              }
            },
            "required": [
              "ai_generated"
            ]
          },
          "then": {
            "required": [
              "ai_reason",
              "ai_sources"
            ],
            "properties": {
              "ai_reason": {
                "type": "string",
                "minLength": 1
              },
              "ai_sources": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "items": {
                  "allOf": [
                    {
                      "$ref": "common.schema.json#/$defs/evidence"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "location": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "location"
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "ai_generated": {
                "const": false
              }
            },
            "required": [
              "ai_generated"
            ]
          },
          "then": {
            "properties": {
              "ai_sources": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "condition_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition_id",
        "status",
        "reason",
        "evidence"
      ],
      "properties": {
        "condition_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "met",
            "not_met",
            "needs_review"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/evidence"
          }
        }
      },
      "if": {
        "properties": {
          "status": {
            "enum": [
              "met",
              "not_met"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "minItems": 1
          }
        }
      }
    },
    "excluded_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "reason",
        "evidence"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/evidence"
          }
        }
      }
    },
    "fallback_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "amount_in_period_won": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
