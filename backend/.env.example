# Optional F13 published-clause reader connection. Run migrations separately with an owner role.
# Omit DATABASE_URL for the existing fictional in-memory example. Files are not auto-loaded.
# Use a SELECT-only runtime role; never put this value in VITE_* or commit a real URL.
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/benefitfinder

# Shared 100/day recommendation+simulation admission. Use a separate restricted writer.
# Required for production/multiple workers; omission is a single-process memory example.
# ANALYSIS_USAGE_DATABASE_URL=postgresql://<usage-user>:<password>@localhost:5432/benefitfinder

# Published cash/services via POLICY_DATABASE_URL; service publication also requires 0005/0006/0008.
# Runtime connection must be SELECT-only. Omit to keep the fictional development catalogue.
# POLICY_DATABASE_URL=postgresql://<reader>:<password>@localhost:5432/benefitfinder
# Explicit policy-catalog/service-catalog publish commands only; never use the owner as the runtime reader.
# POLICY_PUBLISH_DATABASE_URL=postgresql://<publisher>:<password>@localhost:5432/benefitfinder
# Offline recheck-page export; SELECT/column-grant role, explicit 0006 migration.
# POLICY_RECHECK_DATABASE_URL=postgresql://<recheck-reader>:<password>@localhost:5432/benefitfinder

# Optional local F13 explanations. Omit for template-only responses.
# Pass to the server process explicitly; .env files are not loaded automatically.
# F13_OLLAMA_MODEL=gemma4:e4b

# Shared F12/F13 provider. Disabled by default; .env is not auto-loaded.
# Development: run scripts/llama_server.py and pass these values to the backend.
# LLM_PROVIDER=llama_cpp
# LLM_BASE_URL=http://127.0.0.1:18080/v1
# LLM_MODEL=gemma4-e4b
# LLM_API_KEY_FILE=data/local/llama-cpp/api-key
# Production: LLM_PROVIDER=external_api, explicit HTTPS base URL/model and secret key.
# LLM_API_KEY=

# F08: keep actual values only in data/local/f08.env or the process environment.
YOUTHCENTER_API_KEY=
DISCORD_WEBHOOK_URL=

# Offline ECOS refresh only; runtime reads the last successful rate from PostgreSQL.
ECOS_API_KEY=
# BASE_RATE_WRITE_DATABASE_URL=postgresql://<rate-writer>:<password>@localhost:5432/benefitfinder
# BASE_RATE_DATABASE_URL=postgresql://<rate-reader>:<password>@localhost:5432/benefitfinder

# Optional offline import of complete youthcenter generations (explicit 0005 migration).
# Omit for file-only collection. A configured database failure is a job failure.
# COLLECTION_WRITE_DATABASE_URL=postgresql://<collection-writer>:<password>@localhost:5432/benefitfinder

# Optional prepared-document F12 queue, explicit migration 0007; never publishes.
# With refresh-data, run up to 5 queued inputs after collection; requires LLM_PROVIDER.
# F12_WRITE_DATABASE_URL=postgresql://<f12-worker>:<password>@localhost:5432/benefitfinder
# Optional confirmed API field/scope mapping; requires F12_WRITE_DATABASE_URL.
# F12_PREPARATION_PLAN=data/local/f12-preparation.json
# 보조금24: 공식 API 키와 사람이 확인한 청년 취업·주거 ID/분류 계획
# GOV24_API_KEY=fictional-example-only
# GOV24_PREPARATION_PLAN=data/local/gov24-preparation.json
# 확인한 공식 공고·지침·FAQ의 HTML/PDF 수집 계획(키·원본은 Git 제외).
# OFFICIAL_DOCUMENT_PLAN=data/local/official-documents.json
